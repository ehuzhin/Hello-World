          }
        ]
      ]
    },
    "OpenAI Model": {
      "ai_languageModel": [
        [
          {
            "node": "OpenAI Plan",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Claude Model": {
